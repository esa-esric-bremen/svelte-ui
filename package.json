{
	"name": "svelte-ui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"nginx-config": "node deploy/nginx-config.js"
	},
	"overrides": {
		"cookie": "^1.0.2"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/d3": "^7.4.3",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^22.20.5",
		"d3": "^7.9.0",
		"js-yaml": "^4.1.0",
		"noph-gamepad-components": "^0.1.8",
		"noph-ui": "~0.33.5",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.5",
		"svelte-gamepad-virtual-joystick": "^1.1.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
